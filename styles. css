:root{--green:#176b60;--dark:#104c45;--bg:#f0f5f3;--text:#19302b;--muted:#60736d;--border:#d9e5e0;--white:#fff;--warn:#fff3d6}*{box-sizing:border-box}body{margin:0;font:15px/1.5 Arial,sans-serif;color:var(--text);background:var(--bg)}button,input,select,textarea{font:inherit}button{cursor:pointer}.header{background:var(--green);color:white;padding:20px 16px}.header-row{display:flex;justify-content:space-between;align-items:center;gap:12px}.brand{font-size:29px;font-weight:800;letter-spacing:2px}.subtitle{font-size:12px;opacity:.9}.menu-button{background:transparent;color:white;border:1px solid #ffffff66;border-radius:10px;padding:8px 14px;font-size:23px}.navigation{display:none;background:var(--dark);padding:10px;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}.navigation.open{display:grid}.navigation button{border:1px solid #ffffff33;background:#ffffff12;color:white;padding:12px 5px;border-radius:9px;font-size:13px}.navigation button.active{background:white;color:var(--dark);font-weight:bold}.container{max-width:1100px;margin:auto;padding:18px 14px 38px}.page-title{margin:6px 0;font-size:24px}.page-description{color:var(--muted);margin:0 0 18px}.cards{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.card,.panel{background:white;border:1px solid var(--border);border-radius:15px;padding:18px;box-shadow:0 3px 12px #00000008}.card-label{color:var(--muted);font-size:12px}.card-value{font-size:20px;font-weight:800;margin-top:8px;overflow-wrap:anywhere}.panel{margin-top:16px}.panel h3{margin:0 0 14px}.field{margin-bottom:14px}.field label{display:block;font-size:13px;font-weight:700;margin-bottom:6px}.field input,.field select,.field textarea{width:100%;padding:12px;border:1px solid var(--border);border-radius:9px;background:white;color:var(--text)}.field textarea{min-height:75px}.form-grid{display:grid;grid-template-columns:1fr;gap:0 14px}.primary,.secondary,.danger{border:0;border-radius:9px;padding:12px 14px;margin:3px 5px 3px 0}.primary{background:var(--green);color:white}.secondary{background:#e3f1ec;color:var(--dark)}.danger{background:#fbe6e6;color:#a32a2a}.actions{display:flex;gap:6px;flex-wrap:wrap}.table-wrap{overflow-x:auto}table{width:100%;border-collapse:collapse;min-width:550px;font-size:13px}th,td{border-bottom:1px solid var(--border);padding:11px 9px;text-align:left;vertical-align:top}th{background:#eaf4ef}.notice{background:var(--warn);padding:13px;border-radius:10px;margin:14px 0;font-size:13px}.success{background:#e4f5e8}.empty{color:var(--muted);text-align:center;padding:20px}.footer{text-align:center;color:var(--muted);font-size:12px;padding:22px}.item-row{border:1px solid var(--border);padding:13px;border-radius:12px;margin-bottom:12px}.item-head{display:flex;justify-content:space-between;align-items:center;gap:8px}.item-head h4{margin:0 0 10px}.summary{background:#eaf4ef;border-radius:12px;padding:14px;margin:14px 0}.summary strong{font-size:18px}.pill{display:inline-block;background:#e3f1ec;color:var(--dark);padding:3px 9px;border-radius:20px;font-size:12px}.muted{color:var(--muted);font-size:13px}.hidden{display:none!important}@media(min-width:700px){.cards{grid-template-columns:repeat(4,minmax(0,1fr))}.form-grid{grid-template-columns:1fr 1fr}.navigation.open{grid-template-columns:repeat(4,minmax(0,1fr))}}
